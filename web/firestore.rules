// Firestore security rules for KinetixFSL.
//
// Paste the whole file into: Firebase Console -> Firestore Database -> Rules,
// then press Publish. Replace everything that's there; this is complete.
//
// Collections: `posts` (with votes/shares/comments), `users` (with the follow
// graph, joined-communities and known devices), `communities` (with their
// members), `notifications` (per-user inbox rows) and `conversations` (direct
// messages).

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin authorization ──────────────────────────────────────────────────
    //
    // The admin web console (Kinetix-FSL-Admin) authenticates as a normal
    // Firebase Auth user; what makes it an *admin* is an entry in this
    // allowlist collection. An allowlist was chosen over Firebase custom claims
    // because it is self-documenting and manageable from the console itself,
    // and reads cleanly here with a single exists() — the one extra document
    // read per admin rule evaluation is negligible at admin volume.
    //
    // Bootstrap the FIRST admin by hand in the Firebase console (create
    // admins/{yourUid}); after that the allowlist governs everything below.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Fields any signed-in user may change on someone else's post.
    // Voting, commenting and sharing all work by incrementing these.
    function onlyCounterFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['upvoteCount', 'downvoteCount', 'commentCount',
                  'shareCount', 'viewCount', 'score']);
    }

    // Following someone increments a counter on their profile document, so
    // that one field has to be writable by others — and only that one.
    //
    // The null branch matters: following a user who has never opened the app
    // means their profile document doesn't exist yet, so the counter write is
    // a *create* and `resource` is null. Calling resource.data there raises an
    // evaluation error, which denies the write and rolls back the whole
    // follow transaction — silently.
    function onlyFollowCountsChanged() {
      return resource == null
        ? request.resource.data.keys().hasOnly(['followerCount', 'followingCount'])
        : request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['followerCount', 'followingCount']);
    }

    // True when the signed-in user wrote the post these documents hang off.
    // Used so deleting a post can also clear the votes, shares and comments
    // other people left on it. Costs one document read per evaluation.
    function isPostAuthor(database, postId) {
      return request.auth != null
        && get(/databases/$(database)/documents/posts/$(postId)).data.authorId
           == request.auth.uid;
    }

    // True when the signed-in user created the community with this id. Used so a
    // community's creator can delete member posts when deleting the community.
    // Guarded with exists() so a blank id or an already-deleted community is
    // simply false rather than an evaluation error.
    function isCommunityCreator(database, communityId) {
      return request.auth != null
        && communityId is string && communityId != ''
        && exists(/databases/$(database)/documents/communities/$(communityId))
        && get(/databases/$(database)/documents/communities/$(communityId)).data.creatorId
           == request.auth.uid;
    }

    // A post either targets no community, or the author must have joined the one
    // it targets — so a community's feed can only ever hold its members' posts.
    function postCommunityAllowed() {
      return !('communityId' in request.resource.data)
        || request.resource.data.communityId == ''
        || exists(/databases/$(database)/documents/communities/$(request.resource.data.communityId)/members/$(request.auth.uid));
    }

    match /posts/{postId} {
      // Public: the shared-link web page reads this without signing in.
      allow read: if true;

      // Only a signed-in user, as themselves, and — for a community post — only
      // if they've joined that community.
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && postCommunityAllowed();

      // The author can edit their own post — including moving it to a
      // community they've joined, or back to the Home Feed — subject to the
      // same membership check as creating one. Anyone signed in may move
      // counters (voting, sharing, commenting).
      // The author edits their own post; anyone signed in may move counters;
      // an admin may update any post — needed to set the validation verdict
      // (validationStatus / validatedBy / validatedAt) from the Content
      // Validation queue.
      allow update: if request.auth != null
                    && ((resource.data.authorId == request.auth.uid && postCommunityAllowed())
                        || onlyCounterFieldsChanged()
                        || isAdmin());

      // The author deletes their own post; the community's creator may also
      // delete any post in their community (used when deleting the community).
      // An admin may delete any post — the moderation "delete post" action and
      // the server-side account wipe both rely on this.
      allow delete: if request.auth != null
                    && (resource.data.authorId == request.auth.uid
                        || isCommunityCreator(database, resource.data.get('communityId', ''))
                        || isAdmin());

      // One vote document per user, named with their uid.
      //
      // `get` and `list` are split deliberately. A query over the whole
      // collection can't satisfy `request.auth.uid == userId`, because on a
      // list operation userId isn't bound to any single document — Firestore
      // denies the query outright. Deleting a post has to list these, so the
      // post's author is granted list separately.
      match /votes/{userId} {
        allow get: if request.auth != null && request.auth.uid == userId;
        allow list: if isPostAuthor(database, postId) || isAdmin();
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null
                      && (request.auth.uid == userId
                          || isPostAuthor(database, postId)
                          || isAdmin());
      }

      // One share marker per user — this is what keeps the share count
      // to one per account. Never updated.
      match /shares/{userId} {
        allow get: if request.auth != null && request.auth.uid == userId;
        allow list: if isPostAuthor(database, postId) || isAdmin();
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
        allow delete: if request.auth != null
                      && (request.auth.uid == userId
                          || isPostAuthor(database, postId)
                          || isAdmin());
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.authorId == request.auth.uid;
        allow update: if request.auth != null
                      && resource.data.authorId == request.auth.uid;
        // Comment author, the post's author cleaning up their post, or an admin
        // (moderation "delete comment" and the account wipe).
        allow delete: if request.auth != null
                      && (resource.data.authorId == request.auth.uid
                          || isPostAuthor(database, postId)
                          || isAdmin());
      }
    }

    // Community profiles and the follow graph.
    match /users/{userId} {
      // Public: post cards and follower lists show anyone's name and photo.
      allow read: if true;

      // You may write your own profile. Anyone signed in may move the follower
      // counters, because following someone increments a counter on *their*
      // document — the same pattern as the post counters above.
      // The owner writes their own profile; anyone signed in may move the
      // follower counters (see above); an admin may edit any profile — the
      // account wipe anonymises a deleted learner's name/photo through here.
      allow create, update: if request.auth != null
                            && (request.auth.uid == userId
                                || onlyFollowCountsChanged()
                                || isAdmin());
      // Self-delete is still forbidden (the app anonymises instead), but an
      // admin may hard-delete a learner's profile document.
      allow delete: if isAdmin();

      // Who follows this user. Readable so the followers list works; each
      // follower may only add or remove their own entry.
      //
      // The follower may also refresh the name/photo denormalised onto their
      // own entry here — and nothing else — so changing your profile updates
      // the copy of you in everyone-you-follow's followers list. Without this,
      // the New Message picker, @mention list and follower lists kept showing a
      // stale avatar forever.
      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null
                              && request.auth.uid == followerId;
        allow update: if request.auth != null
                      && request.auth.uid == followerId
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['displayName', 'avatarUrl']);
      }

      // Who this user follows. Private to them — it drives their own feed
      // ordering and every Follow button's state.
      //
      // The followed person may refresh the name/photo denormalised onto this
      // entry (profile sync), limited to those two fields. Reads stay
      // owner-only; the subject writes blind through merge, which is fine —
      // the rule can still evaluate the diff server-side.
      match /following/{targetId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null
                      && request.auth.uid == targetId
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['displayName', 'avatarUrl']);
      }

      // The communities this user has joined. Private to them — it drives the
      // Join buttons and the create-post community picker.
      match /joinedCommunities/{communityId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, delete: if request.auth != null
                              && (request.auth.uid == userId || isAdmin());
        allow update: if false;
      }

      // Posts this user chose to hide from their feed. Private to them — it
      // never shows up anywhere else, so only they may read or write it.
      match /hiddenPosts/{postId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }

      // Communities this user has visited, joined or created — the drawer's
      // Recently Visited list. Browsing history, so private to them.
      match /recentCommunities/{communityId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Who this user has blocked. Private — only they read it, and only they
      // add to it. It's what greys out their own composer.
      match /blocked/{targetId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }

      // Who has blocked this user. The mirror of `blocked`, and the reason
      // blocking works at all: a security rule can only read documents, so the
      // fact has to be written somewhere the *blocked* person's own send can be
      // checked against.
      //
      // Readable by the owner (their client stops offering to send) and
      // writable only by the blocker, naming themselves — nobody can forge a
      // block from a third party.
      match /blockedBy/{blockerId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, delete: if request.auth != null && request.auth.uid == blockerId;
        allow update: if false;
      }

      // Devices this account has signed in on. Private: it exists only so the
      // app can tell "a device I've used before" from "somewhere new" and warn
      // about the second — publishing it would be handing an attacker the list
      // of a user's phones.
      match /devices/{deviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // -----------------------------------------------------------------------
    // Notifications — notifications/{userId}/items/{itemId}
    //
    // Asymmetric on purpose: other people *write* your notifications (that's
    // what "Maria started following you" is), but only you can read them, mark
    // them read, or delete them.
    // -----------------------------------------------------------------------
    match /notifications/{userId}/items/{itemId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // A notification must be attributed to whoever is writing it, and must
      // arrive unread. Without the first clause anyone could forge a message
      // from anyone; without the second, a sender could post something into
      // your list pre-marked read so you never saw it.
      //
      // The blank-sender branch is the app's own system notices (welcome, new
      // device). Those are only ever written by the account they're about,
      // which is what stops anyone dressing a message up as coming from us.
      allow create: if request.auth != null
                    && request.resource.data.isRead == false
                    && (request.resource.data.fromUserId == request.auth.uid
                        || (request.resource.data.fromUserId == ''
                            && request.auth.uid == userId));

      // Marking read and clearing the list are the owner's alone — except that
      // the sender may fix their own name and photo on rows they wrote, which
      // is how a rename reaches notifications already sitting in other people's
      // inboxes. Restricted to those two fields, so it can't be used to rewrite
      // what a notification says or flip it back to unread.
      allow update: if request.auth != null
                    && (request.auth.uid == userId
                        || (request.auth.uid == resource.data.fromUserId
                            && request.resource.data.diff(resource.data).affectedKeys()
                                 .hasOnly(['fromUserName', 'fromUserPhoto'])));

      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Collection-group reads over every user's notification items.
    //
    // The nested rule above does NOT cover this — a collection-group query is
    // matched separately. Renaming yourself needs to find your own past
    // notifications wherever they live, and the `fromUserId` condition is what
    // makes that safe: Firestore only accepts a query it can prove satisfies
    // the rule, so a query without `where fromUserId == <me>` is rejected
    // rather than returning other people's inboxes.
    match /{path=**}/items/{itemId} {
      allow read: if request.auth != null
                  && resource.data.fromUserId == request.auth.uid;
    }

    // -----------------------------------------------------------------------
    // Direct messages
    //
    // A thread's id is the two uids sorted and joined with an underscore, so
    // membership can be read straight off the id. That's deliberate: the
    // alternative is a get() on the conversation document inside every rule
    // evaluation, which bills a document read for each message in a thread.
    // Firebase uids are alphanumeric, so the underscore is unambiguous.
    // -----------------------------------------------------------------------
    function inThread(conversationId) {
      return request.auth != null
        && conversationId.split('_').hasAny([request.auth.uid]);
    }

    // The other person in a thread, derived from its id (uidA_uidB, sorted).
    // Pulled into a function so it can be used inside an exists() path — a bare
    // ternary written inline there does not parse reliably.
    function otherInThread(conversationId) {
      return conversationId.split('_')[0] == request.auth.uid
        ? conversationId.split('_')[1]
        : conversationId.split('_')[0];
    }

    match /conversations/{conversationId} {
      // `resource == null` — the document doesn't exist yet — must be allowed,
      // or a transactional create can't get off the ground. Sending the first
      // message reads this doc inside a transaction to see whether to create
      // it; without the null branch that read dereferences a null `resource`,
      // errors, and is denied, which silently kills every first message from a
      // new account (existing chats were unaffected, since their doc already
      // exists). Reading a non-existent doc leaks nothing — there's no data
      // there — and once it exists the participant check applies as before.
      allow read: if request.auth != null
                  && (resource == null
                      || request.auth.uid in resource.data.participants);

      // Exactly two people, one of whom is you. Creating a thread you aren't
      // in would let someone plant conversations in other people's inboxes.
      allow create: if request.auth != null
                    && request.resource.data.participants.size() == 2
                    && request.auth.uid in request.resource.data.participants
                    && inThread(conversationId);

      // Either participant may move the last-message preview, the unread
      // counts and the typing flags — all three are written by the other side.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;

      // Deleting a thread would delete the other person's copy too. Not
      // something one participant gets to decide.
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if inThread(conversationId);

        // You may only send as yourself, and only if the recipient hasn't
        // blocked you. `blockedBy` is checked rather than the blocker's own
        // `blocked` list because this is the copy the *sender* is allowed to
        // read — which is the whole reason blocking is mirrored into two
        // places. Costs one document read per message sent.
        allow create: if inThread(conversationId)
                      && request.resource.data.senderId == request.auth.uid
                      && !exists(/databases/$(database)/documents/users/$(otherInThread(conversationId))/blockedBy/$(request.auth.uid));

        // The recipient flips `isRead` — so update is open to both sides, but
        // only for that field. Message text is not editable by anyone.
        allow update: if inThread(conversationId)
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['isRead']);

        // A message can only be deleted by whoever sent it — the single-message
        // long-press. "Delete all chat history" no longer touches messages at
        // all: it's a per-user hide (`hiddenFor` + `clearedAt` on the
        // conversation doc), so one person clearing their view never removes the
        // other person's copy. That makes this rule safe to keep strict.
        allow delete: if inThread(conversationId)
                      && resource.data.senderId == request.auth.uid;
      }
    }

    // Communities created through the "Start a community" wizard and browsed
    // through Discover. The category list on each document is what Discover
    // filters on.
    // Joining or leaving a community moves the member counter on the community
    // document, so that one field has to be writable by others — and only that
    // one. Same pattern as the follow counters above.
    function onlyMemberCountChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['memberCount']);
    }

    match /communities/{communityId} {
      // Public, like `posts`: the shared-link web page (/c/{id} on the Worker)
      // reads a community without signing in, so anyone opening a shared link
      // in a browser sees it. In-app browsing is signed-in anyway.
      allow read: if true;

      // Only a signed-in user, and only as the creator (who becomes admin).
      allow create: if request.auth != null
                    && request.resource.data.creatorId == request.auth.uid;

      // The creator/admin edits the community — including adding and removing
      // categories. Anyone signed in may move the member counter, because
      // joining increments it on someone else's community document.
      allow update: if request.auth != null
                    && (resource.data.creatorId == request.auth.uid
                        || onlyMemberCountChanged()
                        || isAdmin());
      allow delete: if request.auth != null
                    && (resource.data.creatorId == request.auth.uid || isAdmin());

      // One member marker per user, named with their uid. Anyone may read the
      // roster; each user only adds or removes their own membership; an admin
      // may clear the roster when wiping a deleted creator's community.
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null
                              && (request.auth.uid == memberId || isAdmin());
        allow update: if false;
      }
    }

    // Collection-group reads. The profile's Comments tab queries every post's
    // comments at once, and the nested rule above does NOT cover that — a
    // collection-group query is matched separately.
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    // -----------------------------------------------------------------------
    // Admin console OTP codes — otp_codes/{uid}
    //
    // The admin web app's second sign-in factor: after a password check
    // succeeds, OtpContext writes a hashed 6-digit code here, then reads/
    // deletes it during verification (see Kinetix-FSL-Admin/src/OtpContext.jsx).
    // Scoped to the signed-in user's own uid — nobody else can plant or read
    // another account's code.
    // -----------------------------------------------------------------------
    match /otp_codes/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // -----------------------------------------------------------------------
    // Learner progress — progress/{uid}
    //
    // A DEDICATED, PRIVATE collection (not the world-readable users profile):
    // the mobile app mirrors each learner's XP/streak/detection analytics here
    // (ProgressSyncWorker). Only the learner may read or write their own doc;
    // the admin console may read every learner's doc (this is what the whole
    // four-level analytics module is computed from) and delete one during an
    // account wipe. The admin never writes a learner's progress.
    // -----------------------------------------------------------------------
    match /progress/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // -----------------------------------------------------------------------
    // Admin allowlist — admins/{uid}
    //
    // Presence of a document here is what grants admin power (see isAdmin()).
    // A user may read their OWN entry (the console checks "am I an admin?");
    // admins may read the whole list (to manage it in-console later). No client
    // write path exists — entries are created in the Firebase console, so the
    // allowlist can never be edited by a compromised client.
    // -----------------------------------------------------------------------
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Account moderation state — accountStatus/{uid}
    //
    // Set by an admin (disable / time-penalty / re-enable); read by the learner
    // so the mobile app can enforce it at sign-in (AuthRepository refuses the
    // session and signs out with the reason when `disabled` is true or
    // `lockedUntil` is in the future). Owner-readable so that enforcement can
    // happen client-side; admin-writable only.
    // -----------------------------------------------------------------------
    match /accountStatus/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Community reports — reports/{reportId}
    //
    // Any signed-in user files a report against a post/comment/chat, attributed
    // to themselves and always arriving `open`. Only admins read, resolve or
    // dismiss them — a reporter can't read the moderation queue back.
    // -----------------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.status == 'open';
      allow read, update, delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Admin audit log — auditLog/{entryId}
    //
    // Append-only accountability trail. An admin may read the whole log and
    // append entries attributed to themselves; NOBODY may edit or delete an
    // entry, so the record of who disabled/deleted/penalised whom can't be
    // rewritten after the fact.
    // -----------------------------------------------------------------------
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Broadcasts / announcements — broadcasts/{id}
    //
    // Composed by an admin and fanned out to learners' notification inboxes.
    // Readable by any signed-in user (an in-app announcements list can read it
    // directly); only admins may write.
    // -----------------------------------------------------------------------
    match /broadcasts/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Content overrides — contentOverrides/{categoryId}
    //
    // Admin-managed enable/disable + ordering flags layered over the app's
    // built-in FSL sign catalog (FslSignData). World-readable so the app can
    // honour a disabled module without a privileged read; admin-writable only.
    // -----------------------------------------------------------------------
    match /contentOverrides/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Nothing else is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
