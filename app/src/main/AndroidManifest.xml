<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core feature: on-device sign detection. Required. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Community feed + progress sync only. The app is fully usable without it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Background upload notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="true" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:name=".KinetixApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KinetixFSL">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.KinetixFSL.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Shared post links, e.g.
                https://kinetix-upload.pitardeken2024.workers.dev/p/{postId}

                autoVerify only takes effect once /.well-known/assetlinks.json
                on that host lists this app's signing SHA-256. Until then Android
                shows the app/browser chooser, which still works.
                Keep the host in sync with ShareLinks.HOST.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="kinetix-upload.pitardeken2024.workers.dev"
                    android:pathPrefix="/p/" />
            </intent-filter>

            <!-- What the web page's "Open in app" button fires. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="kinetix"
                    android:host="post" />
            </intent-filter>
        </activity>

        <service
            android:name=".community.upload.PostUploadService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
    </application>

</manifest>